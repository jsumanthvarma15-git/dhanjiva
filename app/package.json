    "gsap": "3.15.0",
    "input-otp": "1.5.0",
    "lenis": "1.3.26",
    "lucide-react": "1.52.0",
    "next-themes": "0.4.6",
    "radix-ui": "1.7.0",
    "react": "19.3.0",
    "react-day-picker": "10.0.2",
    "react-dom": "19.3.0",
    "react-resizable-panels": "4.14.2",
    "recharts": "3.10.1",
    "shadcn": "4.21.4",
    "sonner": "2.0.8",
