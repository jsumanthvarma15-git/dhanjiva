{
  "name": "dhanjiva",
  "private": true,
  "sideEffects": false,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "vite dev",
    "dev:design": "HF_DESIGN_INSPECTOR=1 vite dev --mode design",
    "build": "bun run check:ui && tsr generate && tsc --noEmit && vite build",
    "build:dev": "vite build --mode development",
    "preview": "vite preview",
    "postinstall": "node scripts/verify-install.mjs",
    "lint": "eslint .",
    "format": "prettier --write .",
    "typecheck": "tsr generate && tsc --noEmit",
    "check:ui": "node scripts/check-ui.mjs",
    "check:adapted": "bun scripts/check-adaptation.mjs",
    "test": "bun test tests/*.test.ts",
    "build:vercel": "NITRO_PRESET=vercel bun run build",
    "db:migrate": "bun scripts/migrate-db.ts",
    "test:browser": "node scripts/check-browser.cjs"
  },
  "dependencies": {
    "@base-ui/react": "1.8.0",
    "@higgsfield/app-landing": "workspace:*",
    "@higgsfield/fnf": "workspace:*",
    "@higgsfield/fnf-react": "workspace:*",
    "@higgsfield/quanta": "workspace:*",
    "@phosphor-icons/react": "2.1.10",
    "@shadcn/react": "0.3.1",
    "@tailwindcss/vite": "4.3.3",
    "@tanstack/react-query": "5.104.1",
    "@tanstack/react-router": "1.170.41",
    "@tanstack/react-start": "1.168.60",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
